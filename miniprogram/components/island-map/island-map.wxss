.island-map {
  width: 100%;
}

.island-map-frame {
  width: 100%;
  height: 550rpx;
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(126, 111, 89, 0.16);
  box-shadow: 0 14rpx 34rpx rgba(77, 62, 38, 0.08);
}

.island-map-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.island-map-caption {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9a9082;
  text-align: center;
}
