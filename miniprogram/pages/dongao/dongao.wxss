.dongao-page {
  min-height: 100vh;
  background: #f4efe6;
  padding-bottom: 48rpx;
}

.location-panel {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(126, 111, 89, 0.16);
  box-shadow: 0 12rpx 28rpx rgba(77, 62, 38, 0.07);
  box-sizing: border-box;
}

.location-main {
  flex: 1;
  min-width: 0;
}

.location-label,
.spot-label,
.mission-label,
.mission-info-label,
.mission-safety-label {
  color: #9a9082;
  font-size: 22rpx;
  line-height: 1.35;
}

.location-name {
  margin-top: 7rpx;
  color: #241f19;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  word-break: break-word;
}

.location-note {
  margin-top: 8rpx;
  color: #746b5f;
  font-size: 23rpx;
  line-height: 1.55;
}

.location-actions {
  width: 176rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.location-picker,
.location-clear {
  min-height: 66rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
  transition-property: transform, opacity, background-color;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

.location-picker {
  background: #626247;
  color: #fffdf8;
}

.location-clear {
  background: #faf4ea;
  color: #3f402f;
  box-shadow: inset 0 0 0 1rpx rgba(126, 111, 89, 0.18);
}

.location-clear-disabled {
  opacity: 0.45;
}

.location-picker:active,
.location-clear:active,
.mission-card:active,
.choose-btn:active,
.choose-cancel:active,
.dev-toggle:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.mission-card {
  position: relative;
  width: 100%;
  min-height: 690rpx;
  display: flex;
  flex-direction: column;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(126, 111, 89, 0.16);
  box-shadow: 0 18rpx 40rpx rgba(77, 62, 38, 0.1);
  box-sizing: border-box;
  transition-property: transform, opacity;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

.mission-card-loading {
  overflow: hidden;
}

.card-exit-left {
  animation: card-exit-left 150ms cubic-bezier(0.4, 0, 1, 1) both;
}

.card-exit-right {
  animation: card-exit-right 150ms cubic-bezier(0.4, 0, 1, 1) both;
}

.card-enter-left {
  animation: card-enter-left 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.card-enter-right {
  animation: card-enter-right 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.mission-card-top {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(126, 111, 89, 0.14);
}

.spot-copy {
  flex: 1;
  min-width: 0;
}

.spot-name {
  margin-top: 10rpx;
  color: #241f19;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 780;
  word-break: break-word;
}

.spot-meta {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.spot-distance,
.spot-nav,
.history-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 8rpx 14rpx;
  border-radius: 15rpx;
  font-size: 21rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.spot-distance {
  background: rgba(98, 98, 71, 0.1);
  color: #626247;
}

.spot-nav {
  background: #faf4ea;
  color: #746b5f;
}

.mission-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 300rpx;
  padding: 42rpx 0;
}

.generation-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 430rpx;
  padding: 34rpx 0;
}

.generation-title {
  margin-top: 16rpx;
  color: #241f19;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 750;
}

.generation-progress-panel {
  margin-top: 30rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #faf4ea;
  box-shadow: inset 0 0 0 1rpx rgba(126, 111, 89, 0.14);
}

.generation-progress-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.generation-progress-title {
  flex: 1;
  min-width: 0;
  margin-right: 14rpx;
  color: #3a332b;
  font-size: 23rpx;
  line-height: 1.5;
  font-weight: 600;
  word-break: break-word;
}

.generation-progress-number {
  flex-shrink: 0;
  color: #626247;
  font-size: 23rpx;
  line-height: 1.5;
  font-weight: 700;
}

.generation-progress-track {
  position: relative;
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(126, 111, 89, 0.16);
}

.generation-progress-fill {
  position: relative;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #626247 0%, #9a9577 100%);
  transition: width 520ms cubic-bezier(0.22, 1, 0.36, 1);
}

.generation-progress-fill::after {
  content: "";
  position: absolute;
  top: 0;
  right: -36rpx;
  width: 88rpx;
  height: 100%;
  background: linear-gradient(90deg, rgba(255,253,248,0), rgba(255,253,248,0.58), rgba(255,253,248,0));
  animation: generation-progress-glow 1.8s ease-in-out infinite;
}

.generation-steps {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.generation-step {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 11rpx 14rpx;
  border-radius: 999rpx;
  background: #faf4ea;
  color: #9a9082;
  box-shadow: inset 0 0 0 1rpx rgba(126, 111, 89, 0.1);
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 220ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

.generation-step-dot {
  width: 32rpx;
  height: 32rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: 700;
  background: rgba(126, 111, 89, 0.16);
  color: #746b5f;
}

.generation-step-text {
  font-size: 21rpx;
  line-height: 1.2;
}

.generation-step-done {
  color: #626247;
}

.generation-step-done .generation-step-dot,
.generation-step-active .generation-step-dot {
  background: #626247;
  color: #fffdf8;
}

.generation-step-active {
  background: rgba(98, 98, 71, 0.1);
  color: #3f402f;
  box-shadow: inset 0 0 0 1rpx rgba(98, 98, 71, 0.2);
  animation: step-breathe 1.8s ease-in-out infinite;
}

.mission-skeleton {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: inset 0 0 0 1rpx rgba(126, 111, 89, 0.12);
}

.mission-skeleton-line {
  position: relative;
  overflow: hidden;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(126, 111, 89, 0.14);
}

.mission-skeleton-line + .mission-skeleton-line {
  margin-top: 14rpx;
}

.mission-skeleton-line::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transform: translateX(-100%);
  background: linear-gradient(90deg, rgba(255,253,248,0), rgba(255,253,248,0.74), rgba(255,253,248,0));
  animation: mission-skeleton-shimmer 1.6s ease-in-out infinite;
}

.mission-skeleton-line-main {
  width: 88%;
}

.mission-skeleton-line-sub {
  width: 66%;
}

.mission-skeleton-line-short {
  width: 42%;
}

.mission-body-empty {
  justify-content: center;
}

.mission-text {
  margin-top: 20rpx;
  color: #241f19;
  font-size: 46rpx;
  line-height: 1.55;
  font-weight: 760;
  word-break: break-word;
}

.mission-body-empty .mission-text {
  color: #746b5f;
  font-size: 34rpx;
  font-weight: 650;
}

.mission-info,
.mission-safety {
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #faf4ea;
  box-sizing: border-box;
}

.mission-info-error {
  background: rgba(165, 84, 73, 0.08);
}

.mission-info + .mission-safety {
  margin-top: 16rpx;
}

.mission-info-text,
.mission-safety-text {
  margin-top: 8rpx;
  color: #3a332b;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-word;
}

.mission-info-error .mission-info-label,
.mission-info-error .mission-info-text {
  color: #a55449;
}

.mission-safety {
  background: rgba(184, 132, 69, 0.1);
}

.mission-safety-label,
.mission-safety-text {
  color: #8b683d;
}

.mission-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(126, 111, 89, 0.12);
}

.swipe-hint {
  flex: 1;
  min-width: 0;
  color: #9a9082;
  font-size: 22rpx;
  line-height: 1.45;
}

.history-count {
  background: rgba(98, 98, 71, 0.1);
  color: #626247;
  flex-shrink: 0;
}

.start-btn {
  width: 50%;
  min-width: 320rpx;
  max-width: 420rpx;
  margin: 26rpx auto 0;
  min-height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  box-shadow: 0 16rpx 28rpx rgba(63, 64, 47, 0.18);
}

.start-btn-disabled {
  background: #9a9082;
  box-shadow: none;
  opacity: 0.72;
}

.start-main {
  color: #fffdf8;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.start-sub {
  max-width: 100%;
  margin-top: 8rpx;
  color: rgba(255, 253, 248, 0.78);
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
  word-break: break-word;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(36, 31, 25, 0.22);
  box-sizing: border-box;
}

.overlay-card,
.choose-card {
  width: 100%;
  max-width: 620rpx;
  border-radius: 30rpx;
  background: #fffdf8;
  box-shadow: 0 22rpx 50rpx rgba(36, 31, 25, 0.16);
  box-sizing: border-box;
}

.overlay-card {
  padding: 34rpx;
}

.overlay-title,
.choose-title {
  color: #241f19;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
}

.overlay-text {
  margin-top: 12rpx;
  color: #746b5f;
  font-size: 25rpx;
  line-height: 1.6;
}

.choose-card {
  padding: 34rpx;
}

.choose-options {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.choose-btn {
  flex: 1;
  min-width: 0;
  min-height: 150rpx;
  padding: 24rpx 18rpx;
  border-radius: 24rpx;
  background: #faf4ea;
  box-shadow: inset 0 0 0 1rpx rgba(126, 111, 89, 0.16);
  box-sizing: border-box;
  transition-property: transform, opacity;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

.choose-label {
  color: #241f19;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.choose-desc {
  margin-top: 10rpx;
  color: #746b5f;
  font-size: 22rpx;
  line-height: 1.45;
}

.choose-cancel {
  min-height: 76rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf8;
  color: #746b5f;
  box-shadow: inset 0 0 0 1rpx rgba(126, 111, 89, 0.16);
  font-size: 25rpx;
  transition-property: transform, opacity;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

.dev-toggle {
  margin-top: 24rpx;
  min-height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(98, 98, 71, 0.09);
  color: #746b5f;
  font-size: 23rpx;
  transition-property: transform, opacity;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

.dev-panel {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(126, 111, 89, 0.16);
  box-sizing: border-box;
}

.dev-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dev-btn {
  flex: 1 1 45%;
  min-width: 0;
  font-size: 22rpx !important;
  color: #3f402f;
  background: #faf4ea;
}

.dev-log {
  max-height: 220rpx;
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: #241f19;
  box-sizing: border-box;
}

.dev-log text {
  color: #f4efe6;
  font-size: 20rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.debug-detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  background: rgba(36, 31, 25, 0.32);
  box-sizing: border-box;
}

.debug-detail-panel {
  width: 100%;
  max-height: 78vh;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 24rpx 60rpx rgba(36, 31, 25, 0.2);
  overflow: hidden;
}

.debug-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(126, 111, 89, 0.14);
  background: #faf4ea;
}

.debug-detail-title {
  flex: 1;
  min-width: 0;
  color: #241f19;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.debug-detail-close {
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #626247;
  color: #fffdf8;
  font-size: 23rpx;
  line-height: 1.2;
}

.debug-detail-scroll {
  height: 58vh;
  padding: 22rpx;
  box-sizing: border-box;
  background: #241f19;
}

.debug-detail-scroll text {
  color: #f4efe6;
  font-size: 21rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}

@keyframes card-exit-left {
  100% {
    opacity: 0;
    transform: translateX(-72rpx) rotate(-1.2deg);
  }
}

@keyframes card-exit-right {
  100% {
    opacity: 0;
    transform: translateX(72rpx) rotate(1.2deg);
  }
}

@keyframes card-enter-left {
  0% {
    opacity: 0;
    transform: translateX(72rpx) rotate(1.2deg);
  }
  100% {
    opacity: 1;
    transform: translateX(0) rotate(0);
  }
}

@keyframes card-enter-right {
  0% {
    opacity: 0;
    transform: translateX(-72rpx) rotate(-1.2deg);
  }
  100% {
    opacity: 1;
    transform: translateX(0) rotate(0);
  }
}

@keyframes generation-progress-glow {
  0% {
    transform: translateX(-24rpx);
    opacity: 0.18;
  }
  50% {
    opacity: 0.58;
  }
  100% {
    transform: translateX(14rpx);
    opacity: 0.18;
  }
}

@keyframes mission-skeleton-shimmer {
  100% {
    transform: translateX(100%);
  }
}

@keyframes step-breathe {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
  100% {
    transform: scale(1);
  }
}
