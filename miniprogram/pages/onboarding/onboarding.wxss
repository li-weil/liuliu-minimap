page {
  background: #f5f2ed;
}

/* 莫兰迪柔和风：米白底 + 深墨标题 + 粉彩圆形选项 */
.ob-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 100rpx 48rpx 200rpx;
  display: flex;
  flex-direction: column;
  background: #f5f2ed;
}

.ob-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ob-step-pill {
  background: #626247;
  color: #f4f2ec;
  font-size: 26rpx;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
}

.ob-skip {
  font-size: 26rpx;
  color: #9a9a90;
  padding: 8rpx 16rpx;
}

.ob-title-block {
  margin-top: 72rpx;
  position: relative;
}

.ob-kicker-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.ob-kicker {
  font-size: 30rpx;
  font-style: italic;
  color: #6f9483;
  line-height: 1.3;
}

.ob-q-icon {
  width: 88rpx;
  height: 88rpx;
}

/* 手绘感下划线 */
.ob-kicker::after {
  content: "";
  display: block;
  width: 120rpx;
  height: 10rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: #e8dcb0;
  transform: rotate(-1.5deg);
}

.ob-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #1f2924;
  line-height: 1.32;
}

.ob-hint {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #8a948d;
  line-height: 1.5;
}

.ob-mascot {
  position: absolute;
  right: 0;
  bottom: -36rpx;
  width: 150rpx;
  height: 150rpx;
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 插图选项卡片：两列铺满，贴纸插图 + 文字 */
.ob-circles {
  flex: 1;
  margin-top: 44rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 40rpx;
  justify-content: center;
  align-content: flex-start;
  position: relative;
}

.ob-option {
  width: calc(50% - 22rpx);
  min-height: 238rpx;
  border-radius: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24rpx 14rpx;
  box-sizing: border-box;
  gap: 12rpx;
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.ob-opt-img {
  width: 108rpx;
  height: 108rpx;
}

.ob-opt-label {
  font-size: 26rpx;
  line-height: 1.4;
  color: #33403a;
}

.ob-c0 { background: #e0d6c2; }
.ob-c1 { background: #ede9b4; }
.ob-c2 { background: #dde3d2; }
.ob-c3 { background: #eed5cc; }
.ob-c4 { background: #f2e4cf; }

.ob-option.picked {
  background: #626247;
  transform: scale(1.05);
  box-shadow: 0 18rpx 36rpx rgba(63, 64, 47, 0.28);
}

.ob-option.picked .ob-opt-label {
  color: #f4f2ec;
  font-weight: 600;
}

/* 海岛像素小装饰 */
.ob-deco {
  position: absolute;
  pointer-events: none;
}

.ob-deco-fish {
  top: -30rpx;
  right: 8rpx;
  width: 76rpx;
  height: 76rpx;
  opacity: 0.9;
}

.ob-deco-shell {
  left: 20rpx;
  bottom: 190rpx;
  width: 84rpx;
  height: 84rpx;
}

.ob-deco-starfish {
  right: 32rpx;
  bottom: 220rpx;
  width: 72rpx;
  height: 72rpx;
  transform: rotate(12deg);
}

.ob-deco-sailboat {
  top: -36rpx;
  left: 8rpx;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.92;
}

.ob-deco-crab {
  right: 44rpx;
  bottom: 168rpx;
  width: 64rpx;
  height: 64rpx;
  transform: rotate(-6deg);
}

/* 底部深蓝横条 */
.ob-bottom-bar {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 26rpx 34rpx;
  border-radius: 32rpx;
  background: #3f402f;
  color: rgba(244, 242, 236, 0.92);
  font-size: 25rpx;
  text-align: center;
  line-height: 1.4;
}

.ob-bar-cat {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
