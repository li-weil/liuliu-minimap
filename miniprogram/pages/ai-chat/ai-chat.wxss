.ai-chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
  box-sizing: border-box;
  background: #f4efe6;
}

.ai-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 8rpx 20rpx;
}

.ai-avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fdfbf5;
  box-shadow: inset 0 0 0 2rpx rgba(98, 98, 71, 0.28), 0 6rpx 16rpx rgba(63, 64, 47, 0.12);
}

.ai-hero-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #22312c;
  line-height: 1.3;
}

.ai-hero-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7d9089;
  line-height: 1.4;
}

.ai-hero-fish {
  margin-left: auto;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
}

.ai-message-list {
  flex: 1;
  min-height: 0;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.ai-msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.ai-msg-row-user {
  justify-content: flex-end;
}

.ai-bubble {
  max-width: 78%;
  padding: 20rpx 26rpx;
  border-radius: 26rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(98, 98, 71, 0.14);
  font-size: 28rpx;
  line-height: 1.6;
  color: #22312c;
  word-break: break-all;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(63, 64, 47, 0.06);
}

.ai-msg-row-user .ai-bubble {
  background: #626247;
  border-color: rgba(63, 64, 47, 0.6);
  color: #fdfbf5;
}

.ai-bubble-pending {
  opacity: 0.7;
}

.ai-list-tail {
  height: 24rpx;
}

.ai-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
}

.ai-mic {
  flex-shrink: 0;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: #efe7da;
  color: #626247;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.ai-mic:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.ai-input {
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  padding: 16rpx 24rpx;
  border-radius: 22rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(98, 98, 71, 0.14);
  font-size: 28rpx;
  box-sizing: border-box;
}

.ai-send {
  flex-shrink: 0;
  min-height: 76rpx;
  padding: 0 30rpx;
  border-radius: 22rpx;
  background: #626247;
  color: #fdfbf5;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  transition-property: transform, opacity;
  transition-duration: 160ms;
}

.ai-send:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.ai-send-disabled {
  opacity: 0.45;
}
